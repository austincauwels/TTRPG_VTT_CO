+    with support.ws_connect(client, ch["id"]) as ws:
+        ws.send("take_mark", mark_type="body", is_from_enemy=True)
+        [first] = ws.sync()
+    _restart(monkeypatch)
+    with support.ws_connect(client, ch["id"]) as ws:
