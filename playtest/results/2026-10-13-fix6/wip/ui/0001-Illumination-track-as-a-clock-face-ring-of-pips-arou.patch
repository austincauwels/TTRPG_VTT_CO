+/* The Illumination ring (#67): twelve pips on a clock face around the candle. --r is the
+   radius to a pip's centre and --box the square it sits in. On a touch screen a live pip
+   is a 44px square target on a radius of 120px: two neighbours are at least 0.366 x 120 =
+   44px apart on one axis (the closest pair, 1 and 2, sit diagonally), so the squares never
+   overlap; with a mouse the ring is smaller. The candle warms from sepia to gold as
+   the track fills (--warm) and is lit when full. */
+.illum-ring { --r: 66px; --box: 168px; --hit: 24px; position: relative; width: var(--box); height: var(--box); }
+.illum-ring-compact { --r: 58px; --box: 150px; }
+@media (pointer: coarse) {
+  .illum-ring:not(.illum-ring-compact) { --r: 120px; --box: 268px; --hit: 44px; }
+}
+.illum-pip {
+  position: absolute; display: flex; align-items: center; justify-content: center;
