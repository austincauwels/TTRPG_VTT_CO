From c2183ea100421fd4185aee14b9e2f5ad62a7e973 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 09:07:18 +0000
Subject: [PATCH 3/6] Ask for the roster only while the desk's investigator is
 active

A dead investigator's player opening a retired campaign's desk got a
403 in the console (issue #22): the sidebar and the reconnect path
fetched the roster for any campaign_id, and the route serves only the
Lightkeeper and active members. Both now ask only for an active
investigator; the sidebar asks again when the status changes.

Checked in Chromium at 390x844, 820x1180 and 1366x768: on 77452a3 the
desk made two roster requests (open and reconnect), both 403; now none,
and no console errors. Frontend builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WaLz6UBTQ5XaTKSYwqeMKA
---
 docs/refactor/QUIRKS.md                       | 1 +
 frontend/src/components/pc/TactileSidebar.jsx | 6 ++++--
 frontend/src/store/gameStore.js               | 7 ++++---
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/docs/refactor/QUIRKS.md b/docs/refactor/QUIRKS.md
index fb28261..9cf1b0d 100644
--- a/docs/refactor/QUIRKS.md
+++ b/docs/refactor/QUIRKS.md
@@ -205,3 +205,4 @@ Issues #22, #38, #39, #41, #42 and #47, decisions 3, 4 and 5: the dead are a rec
 
 - The server took a fifth scar from a dead investigator's own socket, and a relationship proposal from the dead over REST or to the dead over either (issue #38). apply_scar is in DEAD_REFUSED, and both propose paths refuse a dead proposer or recipient with 409 "<name> is dead: the sheet is a record.". A relationship agreed or proposed before the death is kept as it is. Tests: test_ws_circle.test_no_relationship_proposal_from_or_to_the_dead, test_ws_circle.test_the_dead_take_no_fifth_scar, test_circle_rest.test_no_proposal_from_or_to_the_dead.
 - A replacement approved through a join request started with 0 spends used, so a player could take two more in the same break (issue #41). approve_investigator now carries the larger spend count of the dead predecessors still active, as rejoin does. Test: test_campaigns.test_approve_keeps_the_players_spends_from_the_dead_predecessor.
+- A dead investigator's player opening the desk of a retired campaign got a 403 in the console (issue #22): the desk asked for the roster on opening and on every reconnect, and the roster route serves only the Lightkeeper and active members. The desk asks only while its investigator is active (TactileSidebar.jsx and the store's reconnect). Checked in Chromium (no roster request, no 403); no backend change.
diff --git a/frontend/src/components/pc/TactileSidebar.jsx b/frontend/src/components/pc/TactileSidebar.jsx
index c9bff62..197955e 100644
--- a/frontend/src/components/pc/TactileSidebar.jsx
+++ b/frontend/src/components/pc/TactileSidebar.jsx
@@ -176,9 +176,11 @@ export const TactileSidebar = ({ phonePart }) => {
   const relationships = circleCreation?.relationships || [];
   const myPhoto = character?.profile_pic || character?.profilePic || null;
 
+  // Only a member may read the roster: a pending investigator, or one retired with its
+  // campaign or replaced (the dead of a retired campaign), would only get a 403 (issue #22)
   useEffect(() => {
-    if (character?.campaign_id) fetchRoster(character.campaign_id);
-  }, [character?.campaign_id]);
+    if (character?.campaign_id && character.status === 'active') fetchRoster(character.campaign_id);
+  }, [character?.campaign_id, character?.status]);
 
   const phoneShows = (part) => phonePart === undefined || phonePart === part;
   const onPhone = (part) => (phoneShows(part) ? '' : 'max-md:hidden');
diff --git a/frontend/src/store/gameStore.js b/frontend/src/store/gameStore.js
index 3b9e9b6..f9d6520 100644
--- a/frontend/src/store/gameStore.js
+++ b/frontend/src/store/gameStore.js
@@ -722,12 +722,13 @@ const useGameStore = create(
             const campaignId = lastPlayedCampaign.campaignId ?? accessSession?.campaignId;
             get().fetchRoster(campaignId, { keep: true });
             get().fetchCircleCreationState(campaignId);
-          } else if (keepLog && get().character?.campaign_id) {
+          } else if (keepLog && get().character?.campaign_id && get().character.status === 'active') {
             // A player's desk: a death or a revival (member_status) that came while it was
             // down is in the roster, which its circle's cards and ally pickers read, and the
-            // other players' votes are on its formation papers
+            // other players' votes are on its formation papers. Only a member may read them:
+            // a pending or retired investigator would get a 403 (issue #22)
             get().fetchRoster(get().character.campaign_id, { keep: true });
-            if (get().character.status === 'active') get().fetchCircleCreationState(get().character.campaign_id);
+            get().fetchCircleCreationState(get().character.campaign_id);
           }
         };
         socket.onerror = (err) => console.error("WebSocket connection error:", err);
