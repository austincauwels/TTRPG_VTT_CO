From c0d3167b81b4235ad6f9461618962810d1d2a9f3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 12:20:05 +0000
Subject: [PATCH 4/4] Fix Chapter House status crash and skip link notes

The Chapter House status read an undefined variable and crashed the desk on
focus; it is defined now. 'Saved' shows only when the socket was open at the
send, and the example buttons go through the same send. The skip link now
shows in flow instead of floating over the file number, QUIRKS says which Tab
stop it is, and the empty-gear line is not shown for a dead investigator.
Checked: vite build; Chromium phone, formation table: focus, typing, blur
read blank, Not saved yet, Saved with no page error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WaLz6UBTQ5XaTKSYwqeMKA
---
 docs/refactor/QUIRKS.md                            |  2 +-
 frontend/src/components/pc/CircleCreationPopup.jsx | 14 +++++++++-----
 frontend/src/components/pc/InvestigatorDossier.jsx |  4 ++--
 3 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/docs/refactor/QUIRKS.md b/docs/refactor/QUIRKS.md
index 8521a8c..62b7304 100644
--- a/docs/refactor/QUIRKS.md
+++ b/docs/refactor/QUIRKS.md
@@ -246,5 +246,5 @@ Frontend only; there is no test runner for it, so each was checked in Chromium (
 - A refused Edit sheet (`action_rejected` for `edit_sheet`) reopens the editor with the last draft and the server's reason (`InvestigatorDossier.jsx` keeps the draft sent; `SheetEditor` takes `restore`). The gear dialog sends the live gear with only this dialog's additions and removals applied, so an item that changed at the table meanwhile is kept.
 - An ability's typed question, item and split empty when the server has paid (`abilityUsed`), not when sent: a refusal leaves them in the box.
 - The notebook's preview toggle reads "Edit" while previewing and carries no `aria-pressed` (the label says which way it goes).
-- The Skip to actions link is the first stop of the player's sheet after the desk header; "Spend one less" has `tabIndex -1` at +0d.
+- The Skip to actions link is the third Tab stop on a phone and the sixth on a tablet or laptop (after the desk header controls, which another group owns); "Spend one less" has `tabIndex -1` at +0d.
 - The Chapter House box says "Saved" or "Not saved yet" from what this desk sent against what the circle holds.
diff --git a/frontend/src/components/pc/CircleCreationPopup.jsx b/frontend/src/components/pc/CircleCreationPopup.jsx
index 7b7dd8c..60eb76d 100644
--- a/frontend/src/components/pc/CircleCreationPopup.jsx
+++ b/frontend/src/components/pc/CircleCreationPopup.jsx
@@ -124,7 +124,8 @@ export const CircleCreationPopup = () => {
   const loadedAnswer = useRef(character?.personal_circle_answer || '');
   const sentAnswer = confirmedPersonalAnswer?.characterId === myId ? confirmedPersonalAnswer.answer : loadedAnswer.current;
   const [houseDraft, setHouseDraft] = useState(null);   // the chapter house text while its box has focus
-  const [houseSent, setHouseSent] = useState(null);      // what this desk last sent for the chapter house
+  const [houseSent, setHouseSent] = useState(null);      // {text, ok}: what this desk last sent for the chapter house, and whether the socket was open
+  const house = backstoryAnswers.chapter_house ?? '';
   const houseAtFocus = useRef('');                      // what the box held when it got focus
 
   // ── Ability section state ──
@@ -175,11 +176,14 @@ export const CircleCreationPopup = () => {
   const handleLocationBlur = (e) => {
     // Sent only when this player changed it: an untouched copy would overwrite a newer chapter house
     if (e.target.value !== houseAtFocus.current) {
-      updateBackstoryAnswer(circleId, 'chapter_house', e.target.value);
-      setHouseSent(e.target.value);
+      sendHouse(e.target.value);
     }
     setHouseDraft(null);
   };
+  const sendHouse = (text) => {
+    updateBackstoryAnswer(circleId, 'chapter_house', text);
+    setHouseSent({ text, ok: connectionState === 'open' });
+  };
 
   const sendPersonalAnswer = () => {
     if (connectionState !== 'open') return;
@@ -419,7 +423,7 @@ export const CircleCreationPopup = () => {
               {/* No word until this desk has typed or sent something, as the personal answer's */}
               <p role="status" className="font-serif italic text-sm text-sepia mt-1 text-right min-h-[1.25rem]">
                 {houseDraft !== null && houseDraft !== house ? 'Not saved yet'
-                  : houseSent === null ? '' : house === houseSent ? 'Saved' : 'Not saved yet'}
+                  : houseSent === null ? '' : houseSent.ok && house === houseSent.text ? 'Saved' : 'Not saved yet'}
               </p>
             </div>
 
@@ -428,7 +432,7 @@ export const CircleCreationPopup = () => {
               {EXAMPLE_LOCATIONS.map(loc => (
                 <button
                   key={loc.name}
-                  onClick={() => updateBackstoryAnswer(circleId, 'chapter_house', `${loc.name}: ${loc.description}`)}
+                  onClick={() => sendHouse(`${loc.name}: ${loc.description}`)}
                   className="w-full text-left border border-parchment-deep bg-cream/60 hover:border-sepia hover:bg-cream p-3 rounded-sm transition-all"
                 >
                   <span className="font-serif font-bold text-lg text-ink block">{loc.name}</span>
