From c6423dae0c91f305b8684ce7db30ad37cd398f3d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 05:30:33 +0000
Subject: [PATCH 4/4] Carry sheet_edited on the REST sheet and fix the pinned
 payloads

GET /api/investigators/{id} answers with every field of the socket's
sheet, so CharacterSheet declares sheet_edited too (openapi snapshot
regenerated). The roster and member_status expectations in
test_campaigns, test_investigators and test_ws_rolls include the new
sheet_edited and name fields.

Checked: test_00_startup (fresh database), test_investigators,
test_surface, test_campaigns, test_ws_rolls pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ETKqHLvkfH9k99JTnJzzKA
---
 backend/tests/data/openapi.json     | 5 +++++
 backend/tests/test_campaigns.py     | 6 +++---
 backend/tests/test_investigators.py | 4 ++--
 backend/tests/test_ws_rolls.py      | 2 +-
 backend/vtt/schemas.py              | 2 ++
 5 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/backend/tests/data/openapi.json b/backend/tests/data/openapi.json
index 7869ce8..0652efb 100644
--- a/backend/tests/data/openapi.json
+++ b/backend/tests/data/openapi.json
@@ -1145,6 +1145,11 @@
             "title": "Sense",
             "type": "integer"
           },
+          "sheet_edited": {
+            "default": false,
+            "title": "Sheet Edited",
+            "type": "boolean"
+          },
           "sneak": {
             "default": 0,
             "title": "Sneak",
diff --git a/backend/tests/test_campaigns.py b/backend/tests/test_campaigns.py
index 7a8e571..ad694c6 100644
--- a/backend/tests/test_campaigns.py
+++ b/backend/tests/test_campaigns.py
@@ -1047,8 +1047,8 @@ def test_roster(client):
     member_view = client.get(f"/campaign/{camp['id']}/roster", headers=support.as_owner(active["id"])).json()
     assert all(c.pop("owner_username") for c in body["pending_investigators"] + body["active_investigators"])
     assert {c.pop("owner_username") for c in member_view["pending_investigators"] + member_view["active_investigators"]} == {""}
-    # The marks, picks and owed scar are the Lightkeeper's read alone
-    ours = ("body_marks", "brain_marks", "bleed_marks", "advancement_picks", "scar_pending")
+    # The marks, picks, owed scar and the dot for a player's edit are the Lightkeeper's read alone
+    ours = ("body_marks", "brain_marks", "bleed_marks", "advancement_picks", "scar_pending", "sheet_edited")
     assert all(not any(c[k] for k in ours) for c in member_view["active_investigators"])
     for c in body["pending_investigators"] + body["active_investigators"]:
         for k in ours:
@@ -1078,7 +1078,7 @@ def test_roster(client):
         "owner_username": support.fetch(User, support.fetch(Character, active["id"]).user_id).username,
         # The Lightkeeper's read also tells how the investigator stands
         "incapacitated": False, "scars_count": 0, "body_marks": 0, "brain_marks": 0,
-        "bleed_marks": 0, "advancement_picks": 0, "scar_pending": False,
+        "bleed_marks": 0, "advancement_picks": 0, "scar_pending": False, "sheet_edited": False,
     }
 
 
diff --git a/backend/tests/test_investigators.py b/backend/tests/test_investigators.py
index 8cc7962..2055977 100644
--- a/backend/tests/test_investigators.py
