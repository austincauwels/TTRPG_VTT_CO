From 839c288acb57053c9203672bf519c8a9578b6ce2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 05:03:49 +0000
Subject: [PATCH 1/4] Keep the Dispatch stamp on the letter at every width

From 1024 to 1280 wide the dispatch letter's column was narrower than End
Assignment and Dispatch side by side, so Dispatch ran off the letter's right
edge (71px over at 1024x768, 33px at 1180x820, and clipped by the rail at
1280x720). The stamps' row now wraps: where both do not fit, Dispatch sits
under End Assignment at the right. The letter also takes the slimmer padding
from lg, as it had from xl.

Checked in Chromium at 390x844, 844x390, 820x1180, 1180x820, 1024x768,
1280x720, 1366x768, 1440x900 and 1920x1080 on a sealed and an unsealed
campaign: the button lies inside the letter at every size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ETKqHLvkfH9k99JTnJzzKA
---
 frontend/src/components/gm/SceneManager.jsx | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/frontend/src/components/gm/SceneManager.jsx b/frontend/src/components/gm/SceneManager.jsx
index 0ffe099..512a246 100644
--- a/frontend/src/components/gm/SceneManager.jsx
+++ b/frontend/src/components/gm/SceneManager.jsx
@@ -279,7 +279,7 @@ export const SceneManager = () => {
   ) : `Press again to end it: the dispatch clears. ${ENDS}`;
 
   return (
-    <div ref={letterRef} className="bg-parchment text-ink p-5 sm:p-8 xl:p-5 2xl:p-6 shadow-[5px_10px_25px_rgba(0,0,0,0.8)] border border-parchment-deep relative"
+    <div ref={letterRef} className="bg-parchment text-ink p-5 sm:p-8 lg:p-5 2xl:p-6 shadow-[5px_10px_25px_rgba(0,0,0,0.8)] border border-parchment-deep relative"
          style={{ backgroundImage: 'repeating-linear-gradient(transparent, transparent 27px, rgb(var(--c-sepia) / 0.1) 28px)', backgroundSize: '100% 28px', lineHeight: '28px' }}>
 
       {/* Masking tape strip */}
@@ -385,8 +385,11 @@ export const SceneManager = () => {
       </div>
       )}
 
-      {/* Stamp buttons; End Assignment asks for a second press and says what it clears */}
-      <div className="mt-8 xl:mt-5 flex justify-between items-start gap-4 relative">
+      {/* Stamp buttons; End Assignment asks for a second press and says what it clears.
+          Where the letter is too narrow for both side by side (its column at 1024 to 1280
+          wide), Dispatch goes under End Assignment, still at the right, instead of running
+          off the letter's edge. */}
+      <div className="mt-8 xl:mt-5 flex flex-wrap justify-between items-start gap-x-4 gap-y-4 relative">
         {/* End Assignment: left stamp */}
         <ConfirmAction
           className="flex flex-col items-start gap-2 max-w-[11rem]"
@@ -412,7 +415,7 @@ export const SceneManager = () => {
         />
 
         {/* Dispatch: right stamp */}
-        <div className="flex flex-col items-end gap-2 max-w-[11rem] text-right">
+        <div className="ml-auto flex flex-col items-end gap-2 max-w-[11rem] text-right">
           <button
             onClick={broadcastScene}
             className="relative group transform -rotate-3 hover:rotate-0 transition-transform active:scale-95"
