+++ b/backend/vtt/assignment.py
@@ -0,0 +1,85 @@
+"""An assignment's paperwork on the circle: the players' reports, the Lightkeeper's tally
+of the Illumination they earned, and the circle resources spent between assignments.
+
+All of it lives in the circle's backstory_answers JSON (where the reports always were),
+under "reports" ({character id: {character_name, responses, submitted_at}}), "tally"
+(what the Lightkeeper's one press added) and "spends" (each [character id, resource],
+oldest first), with "assignment", the number of the assignment it belongs to (1 until
+the first End Assignment). End Assignment closes the reports and clears the three
+(clear_paperwork), so the next assignment starts on blank forms.
+
+A report is the investigator's own account, so it goes to the Lightkeeper and to its
+author only: get_circle_dict leaves the reports out, and the circle-creation-state route
+gives a member their own report alone (playtest, 2026-10-09: every desk was sent every
+report). A desk drops the reports it holds when the assignment number changes.
+"""
+import json
+
+REPORTS, TALLY, SPENDS, ASSIGNMENT = "reports", "tally", "spends", "assignment"
+
+
+def answers_of(circle) -> dict:
+    """A new dict of the circle's backstory_answers, whatever the column holds. Changes are
+    written back as a new dict: the JSON column does not see a dict changed in place."""
+    raw = getattr(circle, "backstory_answers", None)
+    if isinstance(raw, str):
+        try:
+            raw = json.loads(raw)
+        except ValueError:
+            raw = None
+    return dict(raw) if isinstance(raw, dict) else {}
+
+
+def reports_of(answers: dict) -> dict:
+    """The filed reports, by character id as text."""
+    raw = answers.get(REPORTS)
+    return dict(raw) if isinstance(raw, dict) else {}
+
+
+def without_reports(answers: dict) -> dict:
+    return {key: value for key, value in answers.items() if key != REPORTS}
+
+
+def assignment_number(answers: dict) -> int:
+    n = answers.get(ASSIGNMENT)
+    return n if type(n) is int and n > 0 else 1
+
+
+def fulfilled_a_key(report) -> bool:
+    """Whether a stored report says its investigator fulfilled an Illumination Key. Reports
+    saved before the bug-fix stage are the bare responses."""
+    if not isinstance(report, dict):
+        return False
+    responses = report.get("responses", report)
+    if not isinstance(responses, dict):
+        return False
+    detail = responses.get("keys_detail")
+    if isinstance(detail, dict):
+        return any(bool(ticked) for ticked in detail.values())
+    return responses.get("keys_fulfilled") in ("some", "all")
+
+
+def key_points(fulfilled: int, players: int) -> int:
+    """Rulebook p. 55: "Earn 2 if some, but not all, players fulfilled an Illumination Key
+    during the session. Earn 4 if every player fulfilled at least one Illumination Key
+    during the session. If nobody in the circle fulfilled any of their Keys, take no
+    additional Illumination." """
+    if fulfilled <= 0:
+        return 0
+    return 4 if fulfilled >= players else 2
+
+
+def spends_of(answers: dict) -> list:
+    """The circle resources spent this assignment, as [character id, resource] pairs."""
+    raw = answers.get(SPENDS)
+    return [list(s) for s in raw if isinstance(s, (list, tuple)) and len(s) == 2] if isinstance(raw, list) else []
+
+
+def clear_paperwork(circle):
+    """End Assignment: the reports close, and the assignment's reports, tally and spends go."""
+    answers = answers_of(circle)
+    for key in (REPORTS, TALLY, SPENDS):
+        answers.pop(key, None)
+    answers[ASSIGNMENT] = assignment_number(answers) + 1
+    circle.backstory_answers = answers
+    circle.reports_open = False
