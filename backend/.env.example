# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# Local dev uses SQLite. Production uses the PostgreSQL URL provided by Render.
# PostgreSQL format: postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./candela_obscura.db

# Comma-separated list of allowed frontend origins.
# Add your deployed frontend URL here before going to production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
