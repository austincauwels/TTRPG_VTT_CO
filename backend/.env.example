# Generate a secure key with: openssl rand -hex 32
# It signs the login tokens. The server refuses to start with this placeholder
# or with a key shorter than 32 characters.
SECRET_KEY=your-secret-key-here

# Local dev uses SQLite. The live and beta sites on GaterGrid use PostgreSQL, which the
# backend tests also need (README, Running the Tests).
# PostgreSQL format: postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./candela_obscura.db

# Comma-separated list of allowed frontend origins.
# Add your deployed frontend URL here before going to production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Sign in with Google: the client ID of the Google OAuth web client. It is public;
# no client secret is used. Leave it empty to turn Google sign-in off. The frontend
# build needs the same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Username and password login and registration: true or false, default true.
# Set it to false once every player signs in with Google.
ALLOW_PASSWORD_LOGIN=true
